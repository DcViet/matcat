---
import TrangPortfolio from '../../../components/TrangPortfolio.astro';
import TrangQuyTrinh from '../../../components/TrangQuyTrinh.astro';
import { CO_PORTFOLIO, DU_AN } from '../../../lib/portfolio';

// Chế độ "tat": không trả đường dẫn nào, nên không có trang portfolio trên trang web.
export function getStaticPaths() {
  if (!CO_PORTFOLIO) return [];
  return [{ params: { slug: undefined } }, { params: { slug: 'quy-trinh' } }, ...DU_AN.map((d) => ({ params: { slug: d.slug } }))];
}

const { slug } = Astro.params;
---

{slug === 'quy-trinh' ? <TrangQuyTrinh lang="en" /> : <TrangPortfolio lang="en" slug={slug} />}
