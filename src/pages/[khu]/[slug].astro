---
import TrangBai from '../../components/TrangBai.astro';
import { tatCaBai } from '../../lib/khu';

export async function getStaticPaths() {
  const bai = await tatCaBai('vi');
  return bai.map((b) => ({ params: { khu: b.khu, slug: b.slug }, props: { bai: b } }));
}

const { bai } = Astro.props;
---

<TrangBai bai={bai} lang="vi" />
