---
import AnhBai from './AnhBai.astro';
import { duong, ngayThang, timKhu } from '../lib/khu';

interface Props {
  bai: Awaited<ReturnType<typeof import('../lib/khu').tatCaBai>>;
  hienKhu?: boolean;
}

const { bai, hienKhu = false } = Astro.props;
---

{
  bai.length === 0 ? (
    <p class="trong">Chưa có bài nào ở đây.</p>
  ) : (
    <ul class="ds-bai">
      {bai.map((b) => (
        <li class="the-bai">
          <AnhBai bai={b} />
          <div>
            <p class="phu">
              {hienKhu && <span class="nhan">{timKhu(b.khu).ten}</span>}
              <time datetime={b.data.date.toISOString()}>{ngayThang(b.data.date)}</time>
            </p>
            <h3>
              <a class="phu-kin" href={duong(`/${b.khu}/${b.id}/`)}>
                {b.data.title}
              </a>
            </h3>
            <p>{b.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
  )
}
