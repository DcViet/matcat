---
import Base from '../layouts/Base.astro';
import AnhBai from './AnhBai.astro';
import DanhSachBai from './DanhSachBai.astro';
import HinhMatCat from './HinhMatCat.astro';
import { KHU, baiCuaKhu, duongNgon, ngayThang, tatCaBai, timKhu } from '../lib/khu';
import { CHU, type Lang } from '../lib/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const chu = CHU[lang];

// Bài nổi bật là bài mới nhất có ảnh bìa; chưa bài nào có ảnh thì lấy bài mới nhất.
const moiNhat = (await tatCaBai(lang)).slice(0, 6);
const noiBat = moiNhat.find((b) => b.data.cover) ?? moiNhat[0];
const conLai = moiNhat.filter((b) => b !== noiBat);
const soBai = Object.fromEntries(
  await Promise.all(KHU.map(async (k) => [k.slug, (await baiCuaKhu(k.slug, lang)).length] as const)),
);
---

<Base lang={lang}>
  <section class="mo-dau mo-dau-chu">
    <div>
      <h1>{chu.heroTruoc}<em>{chu.heroNhan}</em>{chu.heroSau}</h1>
      <p>{chu.heroMoTa}</p>
    </div>
    <HinhMatCat lang={lang} />
  </section>

  {
    noiBat && (
      <>
        <div class="de-muc-khu">
          <h2>{chu.moiNhat}</h2>
        </div>
        <article class="noi-bat the-bai">
          <AnhBai bai={noiBat} lang={lang} />
          <div>
            <p class="phu">
              <span class="nhan">{timKhu(noiBat.khu).ten[lang]}</span>
              <time datetime={noiBat.data.date.toISOString()}>{ngayThang(noiBat.data.date, lang)}</time>
            </p>
            <h3>
              <a class="phu-kin" href={duongNgon(lang, `/${noiBat.khu}/${noiBat.slug}/`)}>
                {noiBat.data.title}
              </a>
            </h3>
            <p>{noiBat.data.description}</p>
            <span class="doc-tiep" aria-hidden="true">{chu.docBai}</span>
          </div>
        </article>
        {conLai.length > 0 && <DanhSachBai bai={conLai} hienKhu lang={lang} />}
      </>
    )
  }

  <div class="de-muc-khu">
    <h2>{chu.baKhu}</h2>
  </div>
  <div class="o-khu">
    {
      KHU.map((k, i) => (
        <a href={duongNgon(lang, `/${k.slug}/`)}>
          <span class="so-khu" aria-hidden="true">0{i + 1}</span>
          <strong>{k.ten[lang]}</strong>
          <span>{k.moTa[lang]}</span>
          <span class="dem-bai">{soBai[k.slug] > 0 ? chu.soBai(soBai[k.slug]) : chu.sapCo}</span>
        </a>
      ))
    }
  </div>
</Base>
