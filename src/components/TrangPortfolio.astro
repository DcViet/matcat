---
import Base from '../layouts/Base.astro';
import { CHE_DO, DU_AN } from '../lib/portfolio';
import { duong, duongNgon } from '../lib/khu';
import type { Lang } from '../lib/i18n';
import '../styles/portfolio.css';

interface Props {
  lang: Lang;
  slug?: string;
}

const { lang, slug } = Astro.props;
const T = {
  vi: {
    ten: 'Portfolio',
    mota: 'Một số dự án thiết kế kiến trúc và nội thất.',
    tieuDe: 'Dự án',
    dan: 'Một vài dự án kiến trúc và nội thất mình đã làm.',
    hienThi: (n: number) => `${n} dự án`,
    quayLai: 'Tất cả dự án',
    loai: 'Loại hình',
    diaDiem: 'Địa điểm',
    tinhTrang: 'Tình trạng',
    hoanThanh: 'Đã hoàn thành',
    thietKe: 'Hoàn thành thiết kế',
    yTuong: 'Ý tưởng',
    yeuCau: 'Đề bài',
    thachGiai: 'Chỗ khó và cách giải',
    thach: 'Chỗ khó',
    giaiPhap: 'Cách giải',
    thuVien: 'Hình ảnh',
    anhDienHoa: 'ảnh diễn họa',
    tiepTheo: 'Dự án tiếp theo',
    cuon: 'Cuộn',
  },
  en: {
    ten: 'Portfolio',
    mota: 'A selection of architecture and interior design projects.',
    tieuDe: 'Work',
    dan: 'A selection of architecture and interior design projects I have worked on.',
    hienThi: (n: number) => `Showing ${n} of ${n} projects`,
    quayLai: 'All projects',
    loai: 'Type',
    diaDiem: 'Location',
    tinhTrang: 'Status',
    hoanThanh: 'Completed',
    thietKe: 'Design completed',
    yTuong: 'Concept',
    yeuCau: 'Brief',
    thachGiai: 'Challenges / Solutions',
    thach: 'Challenge',
    giaiPhap: 'Solution',
    thuVien: 'Images',
    anhDienHoa: 'renderings',
    tiepTheo: 'Next project',
    cuon: 'Scroll',
  },
}[lang];

const idx = slug ? DU_AN.findIndex((d) => d.slug === slug) : -1;
const du = idx >= 0 ? DU_AN[idx] : undefined;
const tiep = du ? DU_AN[(idx + 1) % DU_AN.length] : undefined;
const noindex = CHE_DO !== 'hien';
const gocPf = duongNgon(lang, '/portfolio/');
const tinhTrang = (s: string) => (s === 'completed' ? T.hoanThanh : T.thietKe);
const diaDiem = du ? [du.location[lang], du.country[lang]].filter(Boolean).join(', ') : '';
---

{
  du && tiep ? (
    <Base lang={lang} title={`${du.title[lang]} · ${T.ten}`} description={du.summary[lang]} image={du.cover} noindex={noindex} fontThem>
      <article class="pf">
        <header class="pf-hero">
          <img src={duong(du.cover)} alt="" fetchpriority="high" decoding="async" />
          <div class="pf-hero-lop"></div>
          <div class="pf-wrap pf-hero-khung">
            <div class="pf-hero-tren pf-mono">
              <a href={gocPf}>← {T.quayLai}</a>
              <span>{du.so}</span>
            </div>
            <div class="pf-hero-duoi">
              <p class="pf-mono pf-hero-loai">
                {du.typology[lang]} · {tinhTrang(du.status)}
              </p>
              <h1 class="pf-disp pf-hero-ten">{du.title[lang]}</h1>
              <p class="pf-lead pf-hero-lead">{du.summary[lang]}</p>
            </div>
          </div>
        </header>

        <section class="pf-muc">
          <div class="pf-wrap pf-y-tuong">
            <aside class="pf-ben">
              <dl class="pf-thong-so">
                <dt class="pf-mono">{T.loai}</dt>
                <dd>{du.typology[lang]}</dd>
                {diaDiem && (
                  <>
                    <dt class="pf-mono">{T.diaDiem}</dt>
                    <dd>{diaDiem}</dd>
                  </>
                )}
                <dt class="pf-mono">{T.tinhTrang}</dt>
                <dd>{tinhTrang(du.status)}</dd>
              </dl>
            </aside>
            <div class="pf-chinh">
              <p class="pf-mono pf-nhan-muc">01 — {T.yTuong}</p>
              <p class="pf-disp pf-y-chinh pf-rv">{du.concept[lang]}</p>
              <div class="pf-yeu-cau pf-rv">
                <h2 class="pf-mono">{T.yeuCau}</h2>
                <p>{du.brief[lang]}</p>
              </div>
            </div>
          </div>
        </section>

        <section class="pf-muc pf-muc-nen">
          <div class="pf-wrap">
            <p class="pf-mono pf-nhan-muc">02 — {T.thachGiai}</p>
            <div class="pf-cap">
              {du.challenges.map((c, i) => (
                <div class="pf-hang pf-rv">
                  <span class="pf-disp pf-so-lon" aria-hidden="true">
                    0{i + 1}
                  </span>
                  <div>
                    <h3 class="pf-mono">{T.thach}</h3>
                    <p>{c[lang]}</p>
                  </div>
                  <div>
                    <h3 class="pf-mono pf-do">{T.giaiPhap}</h3>
                    <p>{du.solutions[i]?.[lang]}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>

        <section class="pf-muc">
          <div class="pf-wrap">
            <p class="pf-mono pf-nhan-muc">
              03 — {T.thuVien}{du.imageKind === 'render' ? ` · ${T.anhDienHoa}` : ''}
            </p>
            <div class="pf-tv">
              {du.gallery.map((g, i) => (
                <figure class={i % 3 === 0 ? 'pf-tv-rong pf-rv' : 'pf-rv'}>
                  <img
                    src={duong(g)}
                    alt={`${du.title[lang]}, ${i + 1}/${du.gallery.length}`}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <figcaption class="pf-mono">
                    {String(i + 1).padStart(2, '0')} / {String(du.gallery.length).padStart(2, '0')}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        </section>

        <a class="pf-tiep" href={`${gocPf}${tiep.slug}/`}>
          <div class="pf-wrap">
            <p class="pf-mono">{T.tiepTheo} → {tiep.so}</p>
            <p class="pf-disp pf-tiep-ten">{tiep.title[lang]}</p>
          </div>
        </a>
      </article>
    </Base>
  ) : (
    <Base lang={lang} title={T.ten} description={T.mota} noindex={noindex} fontThem>
      <div class="pf">
        <section class="pf-wrap pf-dau-trang">
          <p class="pf-mono pf-nhan-muc pf-nhan-gach">
            <span class="pf-do">⌀</span>
            <i></i>
            {T.ten}
          </p>
          <div class="pf-dau-luoi">
            <h1 class="pf-disp pf-tieu-de">{T.tieuDe}</h1>
            <p class="pf-lead">{T.dan}</p>
          </div>
        </section>
        <div class="pf-ke"></div>
        <section class="pf-wrap pf-ds">
          <p class="pf-mono pf-dem">{T.hienThi(DU_AN.length)}</p>
          <ul class="pf-luoi">
            {DU_AN.map((d) => (
              <li class="pf-rv">
                <a class="pf-the" href={`${gocPf}${d.slug}/`}>
                  <div class="pf-the-dau pf-mono">
                    <span>
                      <b class="pf-do">{d.so}</b> — {tinhTrang(d.status)}
                    </span>
                    <span>{d.typology[lang]}</span>
                  </div>
                  <div class="pf-the-anh">
                    <img src={duong(d.cover)} alt="" loading="lazy" decoding="async" width="1200" height="900" />
                  </div>
                  <h2 class="pf-disp pf-the-ten">{d.title[lang]}</h2>
                  <p class="pf-the-tomtat">{d.summary[lang]}</p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </Base>
  )
}

<script>
  // Phần tử .pf-rv hiện dần khi cuộn tới. Không có JavaScript hoặc chọn giảm chuyển động: hiện ngay.
  const giam = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cacPhanTu = document.querySelectorAll<HTMLElement>('.pf-rv');
  if (!giam && 'IntersectionObserver' in window && cacPhanTu.length > 0) {
    document.documentElement.classList.add('pf-js');
    const theoDoi = new IntersectionObserver(
      (cacMuc) => {
        for (const m of cacMuc) {
          if (m.isIntersecting) {
            m.target.classList.add('pf-hien');
            theoDoi.unobserve(m.target);
          }
        }
      },
      { threshold: 0.12 },
    );
    cacPhanTu.forEach((e) => theoDoi.observe(e));
  }
</script>
