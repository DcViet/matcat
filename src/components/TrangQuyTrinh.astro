---

<Base lang={lang} title={ND.ten} description={ND.mota} noindex={noindex} fontThem>
  <div class="pf">
    <section class="pf-wrap pf-dau-trang">
      <p class="pf-mono pf-nhan-muc pf-nhan-gach">
        <a href={gocPf}>← {ND.quayLai}</a>
      </p>
      <div class="pf-dau-luoi">
        <h1 class="pf-disp pf-tieu-de pf-tieu-de-vua">{ND.ten}</h1>
        <p class="pf-lead">{ND.dan}</p>
      </div>
    </section>

    <section class="pf-muc pf-muc-nen">
      <div class="pf-wrap">
        <p class="pf-mono pf-nhan-muc">01 — {ND.cacGiaiDoan}</p>
        <ol class="pf-qt">
          {
            ND.buoc.map((b, i) => (
              <li class="pf-qt-buoc pf-rv">
                <div class="pf-qt-dau">
                  <span class="pf-disp pf-qt-so" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="pf-mono">{b.ten}</h3>
                </div>
                <div class="pf-qtt-thanh">
                  <p class="pf-qtt-chip pf-mono">
                    {b.tg && <span>{ND.thoiGian}: {b.tg}</span>}
                    {b.tt && <span class="pf-do">{ND.thanhToanBuoc}: {b.tt}</span>}
                  </p>
                  <p class="pf-qtt-nd">{b.nd}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="pf-muc">
      <div class="pf-wrap">
        <p class="pf-mono pf-nhan-muc">02 — {ND.tracNhiem}</p>
        <div class="pf-hai-cot">
          <div class="pf-rv">
            <h3 class="pf-mono pf-do">{ND.benThietKe}</h3>
            <ul class="pf-ds-chu">{ND.thietKe.map((t) => <li>{t}</li>)}</ul>
          </div>
          <div class="pf-rv">
            <h3 class="pf-mono pf-do">{ND.chuDauTu}</h3>
            <ul class="pf-ds-chu">{ND.chuDauTuDs.map((t) => <li>{t}</li>)}</ul>
          </div>
        </div>
        <p class="pf-disp pf-trich pf-rv">{ND.luuYDeBai}</p>
      </div>
    </section>

    <section class="pf-muc pf-muc-nen">
      <div class="pf-wrap">
        <p class="pf-mono pf-nhan-muc">03 — {ND.thanhToan}</p>
        <div class="pf-tt-luoi">
          {
            ND.thanhToanDs.map(([so, mo]) => (
              <div class="pf-rv">
                <span class="pf-disp pf-so-lon">{so}</span>
                <p class="pf-tt-mo">{mo}</p>
              </div>
            ))
          }
        </div>
        <p class="pf-mono pf-tt-ghi">{ND.ghiChuThanhToan}</p>
      </div>
    </section>

    <section class="pf-muc">
      <div class="pf-wrap">
        <p class="pf-mono pf-nhan-muc">04 — {ND.chiPhi}</p>
        <div class="pf-gia-luoi">
          {
            ND.goi.map((g) => (
              <div class="pf-gia-the pf-rv">
                <p class="pf-mono pf-do">{g.ten} · {ND.goiTen}</p>
                <p class="pf-disp pf-gia-so">{g.gia}</p>
                <p class="pf-mono pf-gia-dv">{ND.donVi}</p>
                <ul class="pf-ds-chu">{g.ds.map((t) => <li>{t}</li>)}</ul>
              </div>
            ))
          }
        </div>
        <div class="pf-he-so pf-rv">
          <h3 class="pf-mono">{ND.heSoTen}</h3>
          <p class="pf-qtt-nd">{ND.heSoMo}</p>
          <dl class="pf-he-so-ds">
            {ND.heSo.map(([dt, k]) => (
              <div>
                <dt class="pf-mono">{dt}</dt>
                <dd class="pf-disp">k = {k}</dd>
              </div>
            ))}
          </dl>
          <p class="pf-mono pf-tt-ghi">{ND.heSoDonVi} · {ND.vat}</p>
        </div>
      </div>
    </section>

    <section class="pf-muc pf-muc-nen">
      <div class="pf-wrap">
        <p class="pf-mono pf-nhan-muc">05 — {ND.dieuKhoan}</p>
        <dl class="pf-dk">
          {
            ND.dieuKhoanDs.map(([t, n]) => (
              <div class="pf-dk-hang pf-rv">
                <dt class="pf-mono">{t}</dt>
                <dd>{n}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="pf-muc">
      <div class="pf-wrap">
        <p class="pf-mono pf-nhan-muc">06 — {ND.khoKhan}</p>
        <dl class="pf-dk">
          {
            ND.khoKhanDs.map(([t, n], i) => (
              <div class="pf-dk-hang pf-rv">
                <dt class="pf-mono"><span class="pf-do">{String(i + 1).padStart(2, '0')}</span> {t}</dt>
                <dd>{n}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <a class="pf-tiep" href={gocPf}>
      <div class="pf-wrap">
        <p class="pf-mono">← {ND.quayLai}</p>
      </div>
    </a>
  </div>
</Base>

<script>
  // Phần tử .pf-rv hiện dần khi cuộn tới. Không có JavaScript hoặc chọn giảm chuyển động: hiện ngay.
  const giam = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cacPhanTu = document.querySelectorAll<HTMLElement>('.pf-rv');
  if (!giam && 'IntersectionObserver' in window && cacPhanTu.length > 0) {
    document.documentElement.classList.add('pf-js');
    const theoDoi = new IntersectionObserver(
      (cacMuc) => {
        for (const m of cacMuc) {
          if (m.isIntersecting) {
            m.target.classList.add('pf-hien');
            theoDoi.unobserve(m.target);
          }
        }
      },
      { threshold: 0.12 },
    );
    cacPhanTu.forEach((e) => theoDoi.observe(e));
  }
</script>
