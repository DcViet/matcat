---
import Base from '../layouts/Base.astro';
import { CHE_DO } from '../lib/portfolio';
import { duongNgon } from '../lib/khu';
import type { Lang } from '../lib/i18n';
import '../styles/portfolio.css';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const noindex = CHE_DO !== 'hien';
const gocPf = duongNgon(lang, '/portfolio/');

const ND = {
  vi: {
    ten: 'Quy trình làm việc',
    mota: 'Từng giai đoạn làm gì, mất bao lâu, thanh toán thế nào và trách nhiệm của mỗi bên.',
    quayLai: 'Tất cả dự án',
    dan: 'Từ lần trao đổi đầu tiên đến ngày bàn giao hồ sơ: mỗi giai đoạn làm gì, mất bao lâu và thanh toán thế nào. Đọc trước để hai bên cùng hiểu rõ.',
    cacGiaiDoan: 'Các giai đoạn',
    tracNhiem: 'Trách nhiệm của hai bên',
    thanhToan: 'Thanh toán',
    chiPhi: 'Chi phí thiết kế',
    dieuKhoan: 'Điều khoản cần lưu ý',
    khoKhan: 'Những khó khăn thường gặp',
    thoiGian: 'Thời gian',
    thanhToanBuoc: 'Thanh toán',
    benThietKe: 'Bên thiết kế',
    chuDauTu: 'Chủ đầu tư',
    luuYDeBai: 'Đề bài càng cụ thể thì thiết kế càng nhanh và đúng ý. Thông tin nhiều chiều sẽ gây nhiễu và dẫn tới sai sót, làm chậm tiến độ chung của cả công trình.',
    ghiChuThanhToan: 'Giá trị hợp đồng tư vấn thiết kế đã bao gồm chi phí giám sát tác giả.',
    buoc: [
      {
        ten: 'Trao đổi ban đầu và đo đạc',
        tg: '3 đến 5 ngày',
        tt: '',
        nd: 'Chủ đầu tư gửi hồ sơ pháp lý của công trình: chứng chỉ quy hoạch, giấy chủ quyền đất hoặc nhà và các giấy tờ liên quan nếu có. Hai bên cũng nói về nhu cầu sử dụng: cần bao nhiêu phòng, hướng nhà, tài liệu phong thủy... Bên thiết kế đo đạc hiện trạng, rồi tư vấn sơ bộ về ý tưởng chung cho công trình.',
      },
      {
        ten: 'Thiết kế sơ bộ',
        tg: '6 đến 15 ngày, tùy độ phức tạp',
        tt: '40%',
        nd: 'Dựa trên những gì hai bên đã thỏa thuận, bên thiết kế lập hồ sơ sơ bộ gồm các mặt bằng và mặt đứng chính. Xong giai đoạn này, bên thiết kế nhận 40% chi phí thiết kế để làm tiếp.',
      },
      {
        ten: 'Thống nhất phương án sơ bộ',
        tg: '5 đến 15 ngày',
        tt: '',
        nd: 'Bên thiết kế trình bày ý tưởng của hồ sơ sơ bộ. Bản vẽ đầu tiên mất 6 đến 8 ngày, sau đó hai bên chỉnh sửa cho tới khi thống nhất, và chủ đầu tư được điều chỉnh tối đa 5 lần. Sau 5 ngày làm việc, bên thiết kế báo lại những điều về hiện trạng thực tế có ảnh hưởng đến thiết kế, rồi hoàn thiện thiết kế và xử lý các phần kỹ thuật như điện nước, kết cấu, vật liệu hoàn thiện. Chỉ khi các hạng mục này đã thống nhất, hai bên mới sang bước ra bản vẽ thi công.',
      },
      {
        ten: 'Hồ sơ kỹ thuật thi công',
        tg: '30 đến 45 ngày, tính từ lúc thống nhất hồ sơ sơ bộ',
        tt: '50%',
        nd: 'Từ bước này, phối cảnh không chỉnh lại nữa. Khoảng 7 đến 10 ngày đầu ra bản vẽ sơ bộ để báo giá thi công, 10 đến 15 ngày sau đó hoàn thiện bộ hồ sơ đầy đủ chi tiết, thống kê vật dụng, tìm mẫu và vật liệu để đề xuất với chủ đầu tư. Nếu gói thiết kế có phần nội thất, hai bên thỏa thuận thêm về trang trí nội thất (bố trí thiết bị, màu hoàn thiện ngoại thất và nội thất) trước khi bàn giao chính thức. Thời hạn có thể đổi theo tính chất và độ phức tạp của công trình, hoặc khi thiết kế có thay đổi. Xong giai đoạn này, bên thiết kế nhận 50% chi phí.',
      },
      {
        ten: 'Bàn giao, nghiệm thu và thanh lý hợp đồng',
        tg: '',
        tt: '10%',
        nd: 'Hai bên ngồi lại thống nhất các hạng mục trước khi hồ sơ được chuyển cho các bên thi công. Bên thiết kế giải thích kỹ về sản phẩm và những phát sinh có thể gặp khi thi công. Hồ sơ bàn giao gồm 2 bộ bản vẽ kỹ thuật thi công. Hai bên ký biên bản bàn giao và nghiệm thu, rồi thanh lý hợp đồng; bên thiết kế nhận 10% chi phí còn lại.',
      },
    ],
    thietKe: [
      'Giai đoạn ý tưởng: đưa ra sơ đồ công năng và hình ảnh về ý tưởng không gian, màu sắc cụ thể cho từng không gian, để chủ đầu tư hiểu rõ chức năng và mong muốn thiết kế của từng nơi.',
      'Thiết kế đúng yêu cầu của chủ đầu tư về chức năng, thẩm mỹ và phong cách.',
      'Giai đoạn thiết kế: giao phối cảnh và bản vẽ đầy đủ các góc, để chủ đầu tư hình dung được màu sắc và vật liệu của từng không gian, đúng tiến độ đã thỏa thuận.',
