---
import '../styles/global.css';
import { GOC, KHU, duong } from '../lib/khu';

interface Props {
  title?: string;
  description?: string;
}

const TEN_TRANG = 'Mặt Cắt';
const { title, description = 'Cắt qua công trình, tác phẩm và ý tưởng để xem bên trong.' } = Astro.props;
const tieuDe = title ? `${title} · ${TEN_TRANG}` : TEN_TRANG;
const duongDan = Astro.url.pathname.slice(GOC.length) || '/';
const diaChi = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDe}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={TEN_TRANG} />
    <meta property="og:title" content={title ?? TEN_TRANG} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:url" content={diaChi} />
    <link rel="canonical" href={diaChi} />
    <link rel="sitemap" href={duong('/sitemap-index.xml')} />
    <link rel="icon" type="image/svg+xml" href={duong('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="dau-trang">
      <div class="khung">
        <a class="ten-trang" href={duong('/')}>
          <span class="ky-hieu" aria-hidden="true">A</span>
          <span>Mặt Cắt</span>
          <span class="ky-hieu" aria-hidden="true">A</span>
        </a>
        <nav aria-label="Các khu nội dung">
          {
            KHU.map((k) => (
              <a href={duong(`/${k.slug}/`)} aria-current={duongDan.startsWith(`/${k.slug}`) ? 'page' : undefined}>
                {k.ten}
              </a>
            ))
          }
          <a href={duong('/gioi-thieu/')} aria-current={duongDan.startsWith('/gioi-thieu') ? 'page' : undefined}>
            Giới thiệu
          </a>
        </nav>
      </div>
      <div class="net-cat" aria-hidden="true">
        <span class="dau-cat dau-cat-trai">A</span>
        <span class="dau-cat dau-cat-phai">A</span>
      </div>
    </header>

    <main class="khung">
      <slot />
    </main>

    <footer class="chan-trang">
      <div class="khung">
        <p>Mặt Cắt · viết về kiến trúc, nghệ thuật và cách nghĩ.</p>
      </div>
    </footer>
  </body>
</html>
