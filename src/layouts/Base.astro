---
import '../styles/global.css';
import { GOC, KHU, duong, duongNgon } from '../lib/khu';
import { CHU, type Lang } from '../lib/i18n';
import { HIEN_TREN_MENU } from '../lib/portfolio';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  // Đường dẫn (không gồm /matcat) của trang tương ứng ở ngôn ngữ kia.
  // Bỏ trống: tự suy ra từ đường dẫn hiện tại. `null`: không có bản dịch, nút chuyển về trang chủ.
  kia?: string | null;
  // Ảnh chia sẻ (đường dẫn gốc, ví dụ /images/x.jpg) và mô tả ảnh.
  image?: string;
  imageAlt?: string;
  // Bài viết: ngày đăng (YYYY-MM-DD), mục và từ khóa, dùng cho thẻ article.
  ngayDang?: string;
  mucBai?: string;
  tuKhoa?: string[];
  // Dữ liệu có cấu trúc (JSON-LD) của riêng trang.
  schema?: object[];
  noindex?: boolean;
}

const TEN_TRANG = 'Mặt Cắt';
const { title, lang = 'vi', kia, image, imageAlt, ngayDang, mucBai, tuKhoa = [], schema = [], noindex = false } = Astro.props;
const chu = CHU[lang];
const description = Astro.props.description ?? chu.moTaMacDinh;

// Google cắt tiêu đề quanh 60 ký tự và mô tả quanh 160: rút gọn cho thẻ meta, giữ nguyên chữ hiển thị trong bài.
const rutGon = (s: string, n: number) => {
  const g = s.replace(/\s+/g, ' ').trim();
  if (g.length <= n) return g;
  const c = g.slice(0, n - 1);
  const i = c.lastIndexOf(' ');
  return (i > n * 0.6 ? c.slice(0, i) : c).replace(/[\s,;:.\-–]+$/, '') + '…';
};
const moTaMeta = rutGon(description, 158);
const moTaXaHoi = rutGon(description, 200);
const tieuDeDay = title ? `${title} · ${TEN_TRANG}` : chu.tenDayDu;
const tieuDe = title && tieuDeDay.length > 62 ? title : tieuDeDay;
const tieuDeXaHoi = title ?? chu.tenDayDu;

const anhXaHoi = /^https?:/.test(image ?? '') ? image! : new URL(duong(image ?? '/images/og-mat-cat.png'), Astro.site).href;
const moTaAnh = imageAlt ?? (image ? title ?? TEN_TRANG : `${TEN_TRANG}: ${chu.moTaMacDinh}`);
const laTrangBai = Boolean(ngayDang);

const duongDan = Astro.url.pathname.slice(GOC.length) || '/';
// Đường dẫn không có tiền tố /en, để nhận biết khu đang mở.
const phan = lang === 'en' ? duongDan.replace(/^\/en(?=\/|$)/, '') || '/' : duongDan;
const diaChi = new URL(Astro.url.pathname, Astro.site).href;

// Trang tương ứng ở ngôn ngữ kia.
const langKia: Lang = lang === 'vi' ? 'en' : 'vi';
const cap = [
  ['/gioi-thieu/', '/about/'],
] as const;
function suyRa(): string {
  if (lang === 'vi') {
    const m = cap.find(([vi]) => phan.startsWith(vi));
    return m ? `/en${m[1]}` : `/en${phan}`;
  }
  const m = cap.find(([, en]) => phan.startsWith(en));
  return m ? m[0] : phan;
}
const duongKia = kia === null ? (langKia === 'en' ? '/en/' : '/') : kia ?? suyRa();
const diaChiKia = new URL(duong(duongKia), Astro.site).href;
const hreflang = lang === 'vi' ? { vi: diaChi, en: diaChiKia } : { vi: diaChiKia, en: diaChi };
const coBanKia = kia !== null;
---

<!doctype html>
<html lang={chu.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tieuDe}</title>
    <meta name="description" content={moTaMeta} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    <meta name="theme-color" content="#f7f4ee" />
    <meta property="og:site_name" content={TEN_TRANG} />
    <meta property="og:title" content={tieuDeXaHoi} />
    <meta property="og:description" content={moTaXaHoi} />
    <meta property="og:type" content={laTrangBai ? 'article' : 'website'} />
    <meta property="og:locale" content={chu.ogLocale} />
    <meta property="og:locale:alternate" content={CHU[langKia].ogLocale} />
    <meta property="og:url" content={diaChi} />
    <meta property="og:image" content={anhXaHoi} />
    <meta property="og:image:alt" content={moTaAnh} />
    {
      laTrangBai && (
        <>
          <meta property="article:published_time" content={ngayDang} />
          <meta property="article:modified_time" content={ngayDang} />
          {mucBai && <meta property="article:section" content={mucBai} />}
          {tuKhoa.map((t) => (
            <meta property="article:tag" content={t} />
          ))}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tieuDeXaHoi} />
    <meta name="twitter:description" content={moTaXaHoi} />
    <meta name="twitter:image" content={anhXaHoi} />
    <meta name="twitter:image:alt" content={moTaAnh} />
    <link rel="canonical" href={diaChi} />
    <link rel="alternate" type="application/rss+xml" title={`${TEN_TRANG} (${lang.toUpperCase()})`} href={duongNgon(lang, '/rss.xml')} />
    {
      coBanKia && (
        <>
          <link rel="alternate" hreflang="vi" href={hreflang.vi} />
          <link rel="alternate" hreflang="en" href={hreflang.en} />
          <link rel="alternate" hreflang="x-default" href={hreflang.vi} />
        </>
      )
    }
    {schema.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <link rel="sitemap" href={duong('/sitemap-index.xml')} />
    <link rel="icon" type="image/svg+xml" href={duong('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="dau-trang">
      <div class="khung">
        <a class="ten-trang" href={duongNgon(lang, '/')}>
          <span class="ky-hieu" aria-hidden="true">A</span>
          <span>Mặt Cắt</span>
          <span class="ky-hieu" aria-hidden="true">A</span>
        </a>
        <nav aria-label={chu.nhanKhu}>
          {
            KHU.map((k) => (
              <a href={duongNgon(lang, `/${k.slug}/`)} aria-current={phan.startsWith(`/${k.slug}`) ? 'page' : undefined}>
                {k.ten[lang]}
              </a>
            ))
          }
          {
            HIEN_TREN_MENU && (
              <a href={duongNgon(lang, '/portfolio/')} aria-current={phan.startsWith('/portfolio') ? 'page' : undefined}>
                Portfolio
              </a>
            )
          }
          <a
            href={duongNgon(lang, lang === 'en' ? '/about/' : '/gioi-thieu/')}
            aria-current={phan.startsWith('/gioi-thieu') || phan.startsWith('/about') ? 'page' : undefined}
          >
            {chu.gioiThieu}
          </a>
          <span class="chon-ngon-ngu" role="group" aria-label={`${CHU.vi.nhanNgonNgu} / ${CHU.en.nhanNgonNgu}`}>
            <a
              href={duong(lang === 'vi' ? (phan.startsWith('/404') ? '/' : phan) : duongKia)}
              lang="vi"
              hreflang="vi"
              aria-current={lang === 'vi' ? 'true' : undefined}>VI</a
            >
            <a
              href={duong(lang === 'en' ? '/en' + (phan === '/' ? '/' : phan) : phan.startsWith('/404') ? '/en/' : duongKia)}
              lang="en"
              hreflang="en"
              aria-current={lang === 'en' ? 'true' : undefined}>EN</a
            >
          </span>
        </nav>
      </div>
      <div class="net-cat" aria-hidden="true">
        <span class="dau-cat dau-cat-trai">A</span>
        <span class="dau-cat dau-cat-phai">A</span>
      </div>
    </header>

    <main class="khung">
      <slot />
    </main>

    <footer class="chan-trang">
      <div class="khung">
        <p>{chu.chanTrang}</p>
      </div>
    </footer>
  </body>
</html>
